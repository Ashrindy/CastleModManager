{
    "app-id": "io.github.ashrindy.castlemodmanager",
    "runtime": "org.freedesktop.Platform",
    "runtime-version": "25.08",
    "sdk": "org.freedesktop.Sdk",
    "command": "castle-mm",
    "finish-args": [
        "--share=ipc",
        "--socket=wayland",
        "--socket=fallback-x11",
        "--device=dri",
        "--filesystem=/media",
        "--filesystem=/run/media",
        "--filesystem=/mnt",
        "--env=GTK_THEME=Adwaita:dark",
        "--share=network"
    ],
    "modules": [
        {
            "name": "glfw",
            "buildsystem": "cmake",
            "builddir": true,
            "config-opts": [
                "-DGLFW_BUILD_EXAMPLES=OFF",
                "-DGLFW_BUILD_TESTS=OFF",
                "-DGLFW_BUILD_DOCS=OFF"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/glfw/glfw/archive/refs/tags/3.5.1.tar.gz",
                    "sha256": "5234f4f29473e9a06bc7847d8371858dd135d38466eeeaa652fdc9f8f9ff0c20"
                }
            ]
        },
        {
            "name": "castle-mod-manager",
            "buildsystem": "cmake",
            "config-preset": "gcc-linux-release",
            "config-opts": [
                "-DCMAKE_PREFIX_PATH=/app",
                "-DENABLE_FLATPAK=ON"
            ],
            "sources": [
                {
                    "type": "dir",
                    "path": "../."
                }
            ]
        }
    ]
}